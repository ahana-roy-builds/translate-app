# Deployed server: production, testflight, or staging. The default is production.
RUNTIME_MODE=staging
PORT=8080
ONLINE_ENABLED=true
RELEASE_BUILD_ID=replace-with-release-candidate-id
BACKEND_OCI_DIGEST=sha256:replace-with-64-lowercase-hex-characters
# Cloud Run injects K_REVISION automatically.
K_REVISION=replace-with-cloud-run-revision

GOOGLE_CLOUD_PROJECT=your-staging-project
GOOGLE_STT_LOCATION=us
GOOGLE_TRANSLATION_LOCATION=us-central1
FIRESTORE_PROJECT=your-staging-project
FIRESTORE_DATABASE=(default)

APPLE_TEAM_ID=YOURTEAMID
# App ID prefix is deliberately separate from Team ID.
APPLE_APP_ID_PREFIX=YOURAPPIDPREFIX
APPLE_BUNDLE_ID=com.yourcompany.LocalLingo.staging
APPLE_APP_STORE_ID=1234567890
APP_ATTEST_ENVIRONMENT=development
APPLE_STOREKIT_ENVIRONMENT=Sandbox
ALLOWED_PRODUCT_IDS=pro.monthly.499,pro.annual.2999
ALLOWED_APP_BUNDLE_VERSIONS=1

# Inject these certificate values from Secret Manager. Each value may be PEM or base64(PEM).
APPLE_APP_ATTEST_ROOT_CA_PEM=
# Comma-separated base64(PEM) roots.
APPLE_STOREKIT_ROOT_CA_PEMS=
# App Store Connect In-App Purchase API credentials. Keep the P8 value in Secret Manager.
APPLE_IAP_SIGNING_KEY_P8=
APPLE_IAP_KEY_ID=ABCDEFGHIJ
APPLE_IAP_ISSUER_ID=00000000-0000-4000-8000-000000000000

CHALLENGE_TTL_MS=120000
SESSION_TTL_MS=900000
CHALLENGE_POOL_SIZE=8
CHALLENGE_POOL_REQUESTS_PER_MINUTE=4
SESSION_ATTEMPTS_PER_MINUTE=6
STOREKIT_SESSION_CONCURRENCY=2
STOREKIT_SESSION_MAXIMUM_OUTSTANDING=6
STOREKIT_NOTIFICATION_CONCURRENCY=1
STOREKIT_NOTIFICATION_MAXIMUM_OUTSTANDING=2
MAX_AUDIO_BYTES=960044
MAX_TEXT_BYTES=8192
REQUEST_DEADLINE_MS=18000
SPEECH_TIMEOUT_MS=10000
TRANSLATION_TIMEOUT_MS=5000
INSTALLATION_RATE_PER_MINUTE=30
ENTITLEMENT_RATE_PER_MINUTE=60
ENTITLEMENT_RATE_PER_DAY=500
MAXIMUM_SUBSCRIPTION_DEVICES=3
INACTIVE_DEVICE_AFTER_MS=2592000000

# Localhost-only fake server:
# RUNTIME_MODE=development npm run dev
