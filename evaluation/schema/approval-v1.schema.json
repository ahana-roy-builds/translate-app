{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locallingo:schema:approval:v1",
  "title": "LocalLingo digest-bound release approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "candidate_sha256", "preflight_sha256", "reviewer_login", "reviewer_id", "approved_at", "waivers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "role": {"enum": ["quality", "security", "privacy", "operations"]},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preflight_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_login": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"},
    "reviewer_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "approved_at": {"type": "string", "format": "date-time"},
    "waivers": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "trusted-artifact.schema.json"}
    }
  }
}
