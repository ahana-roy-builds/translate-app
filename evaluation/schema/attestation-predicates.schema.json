{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locallingo:schema:attestation-predicates:v1",
  "title": "LocalLingo trusted release predicate contracts",
  "oneOf": [
    {"$ref": "#/$defs/iosBuild"},
    {"$ref": "#/$defs/environmentPolicy"},
    {"$ref": "#/$defs/terraformPlan"},
    {"$ref": "#/$defs/deploymentReceipt"},
    {"$ref": "#/$defs/corpusManifest"},
