    {"$ref": "#/$defs/backendProvenance"},
    {"$ref": "#/$defs/backendSbom"},
    {"$ref": "#/$defs/scanReport"}
    ,{"$ref": "device-tier-registry.schema.json"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "time": {"type": "string", "format": "date-time"},
    "artifact": {"$ref": "trusted-artifact.schema.json#/$defs/artifact"},
    "iosBuild": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "configuration", "source_commit", "source_tree", "archive", "ipa", "executable_sha256", "code_directory_hash", "bundle_id", "app_version", "build_number", "embedded_build_id", "entitlements_sha256", "provisioning_profile_sha256", "provisioning_profile_uuid", "team_id", "application_identifier", "signing_certificate_sha256", "xcode_version", "sdk_version", "resolved_config_sha256", "generated_at"],
      "properties": {
        "kind": {"const": "ios-build"}, "schema_version": {"const": "1.0"},
        "configuration": {"enum": ["Release", "TestFlight"]}, "source_commit": {"$ref": "#/$defs/commit"}, "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "archive": {"$ref": "#/$defs/artifact"}, "ipa": {"$ref": "#/$defs/artifact"},
        "executable_sha256": {"$ref": "#/$defs/sha"}, "code_directory_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{40,64}$"},
