      "properties": {
        "kind": {"const": "terraform-plan"}, "schema_version": {"const": "2.0"}, "environment": {"enum": ["production", "testflight"]}, "source_commit": {"$ref": "#/$defs/commit"}, "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "terraform_version": {"const": "1.15.7"},
        "provider_lock_sha256": {"$ref": "#/$defs/sha"}, "configuration_sha256": {"$ref": "#/$defs/sha"}, "backend_config_sha256": {"$ref": "#/$defs/sha"}, "variables_sha256": {"$ref": "#/$defs/sha"}, "binary_plan_sha256": {"$ref": "#/$defs/sha"}, "plan_json_sha256": {"$ref": "#/$defs/sha"}, "v1_plan_provenance": {"$ref": "#/$defs/artifact"}, "image_name": {"type": "string", "minLength": 1}, "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "runnable_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "state_bucket": {"type": "string", "minLength": 3}, "state_prefix": {"type": "string", "minLength": 1}, "state_lineage": {"type": "string", "minLength": 8}, "state_serial": {"type": "integer", "minimum": 0}, "state_object_generation": {"type": "string", "pattern": "^[0-9]+$"}, "state_sha256": {"$ref": "#/$defs/sha"}, "environment_policy_sha256": {"$ref": "#/$defs/sha"}, "project_id": {"type": "string", "minLength": 6}, "region": {"const": "us-central1"}, "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"}, "generated_at": {"$ref": "#/$defs/time"}
