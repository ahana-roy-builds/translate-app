        "environment_variables": {"type": "object", "additionalProperties": {"type": "string"}}, "secret_bindings": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["resource", "version", "value_sha256"], "properties": {"resource": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "value_sha256": {"$ref": "#/$defs/sha"}}}},
        "environment_sha256": {"$ref": "#/$defs/sha"}, "secret_bindings_sha256": {"$ref": "#/$defs/sha"}, "bootstrap_outputs_sha256": {"$ref": "#/$defs/sha"}, "iam_policy_sha256": {"$ref": "#/$defs/sha"}, "generated_at": {"$ref": "#/$defs/time"}
