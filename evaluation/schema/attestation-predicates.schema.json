        "kind": {"const": "corpus-manifest"}, "schema_version": {"const": "2.0"}, "corpus_id": {"type": "string", "minLength": 16}, "cases_sha256": {"$ref": "#/$defs/sha"}, "direction_corpora": {"type": "object", "additionalProperties": false, "required": ["en->es", "es->en", "en->ja", "ja->en"], "properties": {"en->es": {"$ref": "#/$defs/sha"}, "es->en": {"$ref": "#/$defs/sha"}, "en->ja": {"$ref": "#/$defs/sha"}, "ja->en": {"$ref": "#/$defs/sha"}}}, "stimuli_sha256": {"$ref": "#/$defs/sha"}, "answers_sha256": {"$ref": "#/$defs/sha"}, "rights_manifest_sha256": {"$ref": "#/$defs/sha"}, "audio_validation_sha256": {"$ref": "#/$defs/sha"}, "vad_tool_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "fingerprint_tool_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "directions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["en->es", "es->en", "en->ja", "ja->en"]}}, "generated_at": {"$ref": "#/$defs/time"}
      }
