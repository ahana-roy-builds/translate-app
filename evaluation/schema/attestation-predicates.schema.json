      "properties": {
        "kind": {"const": "device-run"}, "schema_version": {"const": "2.0"}, "run_id": {"type": "string", "minLength": 16}, "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"}, "candidate_id": {"type": "string", "minLength": 16}, "corpus_sha256": {"$ref": "#/$defs/sha"}, "v1_corpus_sha256": {"$ref": "#/$defs/sha"}, "v1_run_identity_sha256": {"$ref": "#/$defs/sha"}, "v1_automated_report_sha256": {"$ref": "#/$defs/sha"}, "direction": {"enum": ["en->es", "es->en", "en->ja", "ja->en"]}, "route": {"enum": ["local_only", "online_quality", "auto_local", "auto_online"]}, "device_tier": {"enum": ["minimum", "mid_tier", "current"]}, "environment": {"enum": ["production", "testflight"]}, "device_registry_sha256": {"$ref": "#/$defs/sha"}, "device_identifier": {"type": "string", "pattern": "^iPhone[0-9]+,[0-9]+$"}, "device_udid_sha256": {"$ref": "#/$defs/sha"}, "os_version": {"type": "string", "minLength": 3}, "os_build": {"type": "string", "minLength": 1}, "app_build_id": {"type": "string", "minLength": 16}, "ios_build_attestation_sha256": {"$ref": "#/$defs/sha"}, "backend_image_digest": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]}, "backend_revision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "api_domain": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "app_attest_request_id": {"anyOf": [{"type": "string", "minLength": 8}, {"type": "null"}]}, "outputs": {"$ref": "#/$defs/artifact"}, "timings": {"$ref": "#/$defs/artifact"}, "trace": {"$ref": "#/$defs/artifact"}, "started_at": {"$ref": "#/$defs/time"}, "completed_at": {"$ref": "#/$defs/time"}
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "candidate_id", "source_commit", "source_tree", "report", "release_manifest", "resolved_ios_config", "testflight_resolved_ios_config", "status", "release_decision", "generated_at"],
      "properties": {"kind": {"const": "preflight"}, "schema_version": {"const": "2.0"}, "candidate_id": {"type": "string", "minLength": 16}, "source_commit": {"$ref": "#/$defs/commit"}, "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "report": {"$ref": "#/$defs/artifact"}, "release_manifest": {"$ref": "#/$defs/artifact"}, "resolved_ios_config": {"$ref": "#/$defs/artifact"}, "testflight_resolved_ios_config": {"$ref": "#/$defs/artifact"}, "status": {"const": "passed"}, "release_decision": {"const": false}, "generated_at": {"$ref": "#/$defs/time"}}
    },
    "criteria": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "source_commit", "criteria", "generated_at"],
      "properties": {"kind": {"const": "criteria"}, "schema_version": {"const": "2.0"}, "source_commit": {"$ref": "#/$defs/commit"}, "criteria": {"$ref": "#/$defs/artifact"}, "generated_at": {"$ref": "#/$defs/time"}}
    },
    "backendProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "source_commit", "source_tree", "image_name", "image_digest", "runnable_manifest_digest", "base_image_digest", "v1_build_metadata", "build_context_sha256", "dockerfile_sha256", "builder_id", "generated_at"],
      "properties": {"kind": {"const": "backend-provenance"}, "schema_version": {"const": "1.0"}, "source_commit": {"$ref": "#/$defs/commit"}, "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "image_name": {"type": "string", "minLength": 1}, "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "runnable_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "base_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "v1_build_metadata": {"$ref": "#/$defs/artifact"}, "build_context_sha256": {"$ref": "#/$defs/sha"}, "dockerfile_sha256": {"$ref": "#/$defs/sha"}, "builder_id": {"type": "string", "minLength": 1}, "generated_at": {"$ref": "#/$defs/time"}}
    },
    "backendSbom": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "image_digest", "document", "format", "generator_digest", "generated_at"],
      "properties": {"kind": {"const": "backend-sbom"}, "schema_version": {"const": "1.0"}, "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "document": {"$ref": "#/$defs/artifact"}, "format": {"enum": ["SPDX-2.3", "CycloneDX-1.5"]}, "generator_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "generated_at": {"$ref": "#/$defs/time"}}
    },
    "scanReport": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "image_digest", "report", "scanner_digest", "database_digest", "policy_sha256", "status", "generated_at"],
      "properties": {"kind": {"enum": ["vulnerability-scan", "secret-scan"]}, "schema_version": {"const": "1.0"}, "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "report": {"$ref": "#/$defs/artifact"}, "scanner_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "database_digest": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]}, "policy_sha256": {"$ref": "#/$defs/sha"}, "status": {"const": "passed"}, "generated_at": {"$ref": "#/$defs/time"}}
    }
