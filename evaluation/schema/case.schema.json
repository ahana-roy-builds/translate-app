{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/traveler-translation/evaluation/case.schema.json",
  "title": "Traveler translation evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_language",
    "target_language",
    "source",
    "references",
    "domain",
    "tags",
    "risk",
    "critical_checks",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "source_language": {
      "$ref": "#/$defs/language"
    },
    "target_language": {
      "$ref": "#/$defs/language"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "transit",
        "lodging",
        "dining",
        "directions",
        "shopping",
        "payments",
        "health",
        "emergency",
        "social",
        "logistics"
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      }
    },
    "risk": {
      "type": "string",
      "enum": ["standard", "elevated", "critical"]
    },
    "critical_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/critical_check"
      }
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "critical_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accepted", "required"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "speaker_id",
        "duration_ms",
        "environment",
        "consent_record",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "environment": {
          "type": "string",
          "enum": ["quiet", "street", "station", "vehicle", "restaurant", "lobby", "other"]
        },
        "consent_record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": ["speech", "silence", "noise", "wrong_language"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "author", "license"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["synthetic-original", "commissioned", "consented", "public-domain"]
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_record": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
