{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locallingo.invalid/schema/device-tier-registry.schema.json",
  "title": "LocalLingo physical release device tiers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tiers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "mid_tier", "current"],
      "properties": {
        "minimum": {"$ref": "#/$defs/device"},
        "mid_tier": {"$ref": "#/$defs/device"},
        "current": {"$ref": "#/$defs/device"}
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketing_name", "model_identifier", "soc", "memory_gib", "os_version", "os_build"],
      "properties": {
        "marketing_name": {"type": "string", "minLength": 1},
        "model_identifier": {"type": "string", "pattern": "^iPhone[0-9]+,[0-9]+$"},
        "soc": {"type": "string", "minLength": 1},
        "memory_gib": {"type": "number", "exclusiveMinimum": 0},
        "os_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"},
        "os_build": {"type": "string", "minLength": 1}
      }
    }
  }
}
