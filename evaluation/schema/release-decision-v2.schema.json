{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locallingo:schema:release-decision:v2",
  "title": "LocalLingo final signed release decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "candidate", "approvals", "finalized_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "status": {"const": "approved"},
    "candidate": {"$ref": "trusted-artifact.schema.json"},
    "approvals": {
      "type": "object", "additionalProperties": false,
      "required": ["quality", "security", "privacy", "operations"],
      "properties": {
        "quality": {"$ref": "trusted-artifact.schema.json"},
        "security": {"$ref": "trusted-artifact.schema.json"},
        "privacy": {"$ref": "trusted-artifact.schema.json"},
        "operations": {"$ref": "trusted-artifact.schema.json"}
      }
    },
    "finalized_at": {"type": "string", "format": "date-time"}
  }
}
