{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locallingo.invalid/schema/run-identity.schema.json",
  "title": "LocalLingo release evaluation run identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "release_identity_sha256", "direction", "route",
    "device_tier", "deployment_environment", "app_commit", "app_version",
    "build_number", "app_bundle_id", "api_domain", "device_model_identifier",
    "device_os_version", "device_os_build", "engine_build", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "release_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "direction": {"enum": ["en->es", "es->en", "en->ja", "ja->en"]},
    "route": {"enum": ["local_only", "online_quality", "auto_local", "auto_online"]},
    "device_tier": {"enum": ["minimum", "mid_tier", "current"]},
    "deployment_environment": {"enum": ["testflight", "production"]},
    "app_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "build_number": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "app_bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"},
    "api_domain": {"type": "string", "minLength": 1},
    "device_model_identifier": {"type": "string", "pattern": "^iPhone[0-9]+,[0-9]+$"},
    "device_os_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"},
    "device_os_build": {"type": "string", "minLength": 1},
    "engine_build": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
