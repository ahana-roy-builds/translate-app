{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locallingo:schema:trust-policy:v1",
  "title": "LocalLingo GitHub attestation trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "repository_id", "repository_owner_id", "source_ref", "source_commit", "trusted_root", "signers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "repository_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "repository_owner_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "source_ref": {"type": "string", "pattern": "^refs/tags/v.+$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "trusted_root": {"$ref": "trusted-artifact.schema.json#/$defs/artifact"},
    "signers": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "corpus", "device", "infrastructure", "candidate", "quality", "security", "privacy", "operations", "finalizer"],
      "properties": {
        "build": {"$ref": "#/$defs/signer"},
        "corpus": {"$ref": "#/$defs/signer"},
        "device": {"$ref": "#/$defs/signer"},
        "infrastructure": {"$ref": "#/$defs/signer"},
        "candidate": {"$ref": "#/$defs/signer"},
        "quality": {"$ref": "#/$defs/signer"},
        "security": {"$ref": "#/$defs/signer"},
        "privacy": {"$ref": "#/$defs/signer"},
        "operations": {"$ref": "#/$defs/signer"},
        "finalizer": {"$ref": "#/$defs/signer"}
      }
    }
  },
  "$defs": {
    "signer": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "workflow_sha256", "predicate_types"],
      "properties": {
        "workflow": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.yml$"},
        "workflow_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "predicate_types": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^urn:locallingo:attestation:[a-z0-9-]+:v[0-9]+$"}
        }
      }
    }
  }
}
