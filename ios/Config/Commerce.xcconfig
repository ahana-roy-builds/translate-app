#include "Base.xcconfig"

// Offline translation sold through Apple's In-App Purchase system.
// Register the final identity before configuring providers or uploading.
APP_BUNDLE_IDENTIFIER = REPLACE_COMMERCE_BUNDLE_ID
DEVELOPMENT_TEAM = REPLACE_TEAM_ID
APP_RUNTIME_ENVIRONMENT = commerce
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) COMMERCE
FIREBASE_PREFLIGHT_INPUT = $(SRCROOT)/Resources/GoogleService-Info.plist
RELEASE_BUILD_ID = REPLACE_COMMERCE_RELEASE_BUILD_ID
ACCOUNTS_ENABLED = YES
SUBSCRIPTIONS_ENABLED = YES
TRANSLATION_ACCESS_REQUIRED = YES
STOREKIT_MONTHLY_PRODUCT_ID = REPLACE_COMMERCE_MONTHLY_PRODUCT_ID
STOREKIT_ANNUAL_PRODUCT_ID =
API_BASE_URL =
PRIVACY_POLICY_URL = https:/$()/REPLACE_PRIVACY_POLICY_URL
TERMS_URL = https:/$()/www.apple.com/legal/internet-services/itunes/dev/stdeula/
SUPPORT_URL = https:/$()/REPLACE_SUPPORT_URL
GOOGLE_REVERSED_CLIENT_ID = REPLACE_GOOGLE_REVERSED_CLIENT_ID

#include? "Commerce.local.xcconfig"

ONLINE_FEATURES_ENABLED = NO
FACE_TO_FACE_ENABLED = NO
LOCAL_LLM_EXPERIMENT = 0
