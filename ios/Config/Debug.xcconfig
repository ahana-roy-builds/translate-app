#include "Base.xcconfig"

APP_BUNDLE_IDENTIFIER = com.example.locallingo.debug
DEVELOPMENT_TEAM =
APP_ATTEST_ENVIRONMENT = development
API_BASE_URL = http:/$()/127.0.0.1:8080
STOREKIT_MONTHLY_PRODUCT_ID = pro.monthly.499
STOREKIT_ANNUAL_PRODUCT_ID = pro.annual.2999
PRIVACY_POLICY_URL = https:/$()/example.invalid/privacy
TERMS_URL = https:/$()/example.invalid/terms
SUPPORT_URL = https:/$()/example.invalid/support

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG

// A reviewed internal workspace may provide the explicit experiment condition.
#include? "InternalExperiment.local.xcconfig"

// Optional local bundle identity and signing overrides.
#include? "Debug.local.xcconfig"

// Debug is always the held-phone Local Only milestone. Local overrides may not
// enable deferred product surfaces.
ONLINE_FEATURES_ENABLED = NO
FACE_TO_FACE_ENABLED = NO
