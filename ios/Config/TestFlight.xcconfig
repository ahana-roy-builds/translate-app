#include "Base.xcconfig"

// TestFlight is isolated from production but must use Apple's production App
// Attest entitlement while verifying StoreKit against Sandbox on its backend.
APP_BUNDLE_IDENTIFIER = REPLACE_TESTFLIGHT_BUNDLE_ID
DEVELOPMENT_TEAM = REPLACE_TEAM_ID
APP_ATTEST_ENVIRONMENT = production
APP_RUNTIME_ENVIRONMENT = testflight
RELEASE_BUILD_ID = REPLACE_TESTFLIGHT_RELEASE_BUILD_ID
API_BASE_URL = https:/$()/REPLACE_TESTFLIGHT_API_HOST
STOREKIT_MONTHLY_PRODUCT_ID = REPLACE_TESTFLIGHT_MONTHLY_PRODUCT_ID
STOREKIT_ANNUAL_PRODUCT_ID = REPLACE_TESTFLIGHT_ANNUAL_PRODUCT_ID
PRIVACY_POLICY_URL = https:/$()/REPLACE_PRIVACY_POLICY_URL
TERMS_URL = https:/$()/REPLACE_TERMS_URL
SUPPORT_URL = https:/$()/REPLACE_SUPPORT_URL
MICROPHONE_USAGE_DESCRIPTION = LocalLingo uses the microphone while you start a conversation turn. Local Only processes audio on this iPhone; if you select Online Quality, audio is sent to LocalLingo and Google for speech recognition and translation.
ONLINE_FEATURES_ENABLED = YES
FACE_TO_FACE_ENABLED = YES

LOCAL_LLM_EXPERIMENT = 0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) TESTFLIGHT

#include? "TestFlight.local.xcconfig"
